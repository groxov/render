# Optional monitoring profile settings for deploy/docker-compose.prod.yml.
# Copy this file to deploy/monitoring.env and pass it with --env-file when needed.

UPTIME_KUMA_PORT=3001
BESZEL_PORT=8090
BESZEL_APP_URL=http://localhost:8090

# Fill these values after creating a local system in the Beszel UI.
BESZEL_TOKEN=paste-token-from-beszel
BESZEL_KEY=paste-public-key-from-beszel
